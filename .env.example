# Fuglor AI — Chiavi API (il server ruota automaticamente tra provider e chiavi)
# Puoi mettere fino a 20 chiavi per provider: PREFIX_2, PREFIX_3, ... PREFIX_20
# oppure una lista separata da virgole: GEMINI_API_KEYS="k1,k2,k3"

# --- CONSIGLIATI PER 300 UTENTI (GRATIS) ---
# Groq: https://console.groq.com/keys  (velocissimo, limiti generosi)
GROQ_API_KEY=""
GROQ_API_KEY_2=""
GROQ_API_KEY_3=""

# Cerebras: https://cloud.cerebras.ai/  (gratis, molto veloce)
CEREBRAS_API_KEY=""

# Together: https://api.together.xyz/settings/api-keys  (ha modelli free)
TOGETHER_API_KEY=""

# Gemini: https://aistudio.google.com/apikey  (serve ancora per TTS e trascrizione vocale!)
GEMINI_API_KEY=""
GEMINI_API_KEY_2=""
GEMINI_API_KEY_3=""

# --- OPZIONALI A PAGAMENTO ---
OPENAI_API_KEY=""
MISTRAL_API_KEY=""
COHERE_API_KEY=""
DEEPSEEK_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
